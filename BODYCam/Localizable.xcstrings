          "stringUnit": {
            "state": "translated",
            "value": "Se déclenche à cette heure chaque jour jusqu'à ce que vous l'annuliez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berbunyi pada waktu ini setiap hari sampai Anda membatalkannya."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この時刻に毎日鳴ります。キャンセルするまで続きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "취소할 때까지 매일 이 시간에 울립니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每天在此时间触发，直到你取消为止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每天在此時間觸發，直到你取消為止。"
          }
        }
      }
    },
    "Fires once, at the next time this comes around.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löst einmal aus, zum nächsten Mal, wenn diese Uhrzeit erreicht wird."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se déclenche une seule fois, la prochaine fois que cette heure arrive."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berbunyi satu kali, pada waktu berikutnya yang sesuai."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次にこの時刻が来たときに一度だけ鳴ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음번 이 시간이 되었을 때 한 번만 울립니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在下一次到达该时间时触发一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅在下一次到達該時間時觸發一次。"
          }
        }
      }
    },
    "Flat Bauhaus style, bold shapes, no texture": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Flacher Bauhaus-Stil, kräftige Formen, keine Struktur"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Style Bauhaus plat, formes audacieuses, sans texture"
          }
