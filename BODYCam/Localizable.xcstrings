    "Compact preview, lower power use": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンパクトなプレビュー、消費電力を抑制"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kompakte Vorschau, geringerer Stromverbrauch"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperçu compact, consommation réduite"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预览窗口更小，更省电"
          }
