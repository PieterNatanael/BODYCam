    "Set one from the ⋯ menu when viewing a photo or video in the Gallery.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ギャラリーで写真や動画を表示中に、⋯メニューから設定できます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege eines über das ⋯-Menü fest, wenn du ein Foto oder Video in der Galerie ansiehst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définissez-en un depuis le menu ⋯ lors de l'affichage d'une photo ou vidéo dans la Galerie."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在相册中查看照片或视频时，可通过⋯菜单进行设置。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "갤러리에서 사진이나 동영상을 볼 때 ⋯ 메뉴에서 설정하세요."
          }
        }
      }
    },
    "USES SIGNIFICANTLY MORE STORAGE AND BATTERY": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストレージとバッテリーの消費が大幅に増加します"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DEUTLICH MEHR SPEICHER UND AKKU"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "UTILISE BEAUCOUP PLUS DE STOCKAGE ET DE BATTERIE"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将显著增加存储和电量消耗"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장공간과 배터리를 훨씬 더 많이 사용합니다"
