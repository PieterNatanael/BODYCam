    "This app is provided as-is. We are not liable for any data loss or corruption.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese App wird ohne Gewähr bereitgestellt. Wir haften nicht für Datenverlust oder Datenbeschädigung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette application est fournie en l'état. Nous ne sommes pas responsables de toute perte ou corruption de données."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi ini disediakan apa adanya. Kami tidak bertanggung jawab atas kehilangan atau kerusakan data apa pun."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本アプリは現状のまま提供されます。データの損失や破損について当方は責任を負いません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱은 있는 그대로 제공됩니다. 데이터 손실이나 손상에 대해 책임지지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本应用按现状提供。我们不对任何数据丢失或损坏承担责任。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本應用程式按現狀提供。我們不對任何資料遺失或損毀承擔責任。"
          }
        }
      }
    },
