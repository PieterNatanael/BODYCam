    "Only %lld MB remaining. %@ quality needs at least %lld MB free. Free up storage space or lower the quality before recording.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur noch %lld MB verfügbar. Qualität %@ benötigt mindestens %lld MB frei. Gib vor der Aufnahme Speicherplatz frei oder verringere die Qualität."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ne reste que %lld Mo. La qualité %@ nécessite au moins %lld Mo libres. Libérez de l'espace ou réduisez la qualité avant d'enregistrer."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya tersisa %lld MB. Kualitas %@ memerlukan setidaknya %lld MB ruang kosong. Kosongkan ruang penyimpanan atau turunkan kualitas sebelum merekam."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残り%lld MBです。%@画質には少なくとも%lld MBの空き容量が必要です。録画前にストレージを確保するか画質を下げてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld MB만 남았습니다. %@ 화질은 최소 %lld MB의 여유 공간이 필요합니다. 녹화 전에 저장공간을 확보하거나 화질을 낮추세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅剩 %lld MB。%@ 画质至少需要 %lld MB 可用空间。请在录制前清理存储空间或降低画质。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅剩 %lld MB。%@ 畫質至少需要 %lld MB 可用空間。請在錄製前清理儲存空間或降低畫質。"
          }
        }
      }
    },
    "Only used if you set an alarm or reminder for something you saved.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird nur verwendet, wenn du für etwas Gespeichertes einen Alarm oder eine Erinnerung festlegst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisé uniquement si vous définissez une alarme ou un rappel pour un élément enregistré."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya digunakan jika Anda mengatur alarm atau pengingat untuk sesuatu yang Anda simpan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存した項目にアラームやリマインダーを設定した場合にのみ使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장한 항목에 알람이나 리마인더를 설정한 경우에만 사용됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在你为已保存的内容设置闹钟或提醒时使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅在你為已儲存的內容設定鬧鐘或提醒時使用。"
          }
        }
      }
    },
    "Only used when you choose to save a photo or video to your library.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird nur verwendet, wenn du ein Foto oder Video in deiner Mediathek speicherst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisé uniquement lorsque vous choisissez d'enregistrer une photo ou vidéo dans votre photothèque."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya digunakan saat Anda memilih menyimpan foto atau video ke perpustakaan Anda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真や動画をライブラリに保存する場合にのみ使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진이나 동영상을 라이브러리에 저장할 때만 사용됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在你选择将照片或视频保存到图库时使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅在你選擇將照片或影片儲存到圖庫時使用。"
          }
        }
      }
    },
