            "state": "translated",
            "value": "删除视频？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동영상을 삭제할까요?"
          }
        }
      }
    },
    "This cannot be undone.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この操作は元に戻せません。"
