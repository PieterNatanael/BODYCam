        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vollbildvorschau, höherer Akkuverbrauch"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperçu plein écran, consomme plus de batterie"
          }
