    "Photo": {},
    "Photos and videos may be lost due to bugs or device issues. Back up important footage.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos und Videos können durch Fehler oder Gerätestörungen verloren gehen. Sichere wichtiges Filmmaterial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les photos et vidéos peuvent être perdues en cas de bug ou de problème avec l'appareil. Sauvegardez vos enregistrements importants."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto dan video dapat hilang akibat bug atau masalah perangkat. Cadangkan rekaman penting."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バグや端末の不具合により、写真や動画が失われる可能性があります。重要な映像はバックアップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버그나 기기 문제로 사진과 동영상이 손실될 수 있습니다. 중요한 영상은 백업하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由于程序错误或设备问题，照片和视频可能会丢失。请备份重要素材。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由於程式錯誤或裝置問題，照片和影片可能會遺失。請備份重要素材。"
          }
        }
      }
    },
