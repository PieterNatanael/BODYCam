        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작은 미리보기, 전력 소모 감소"
          }
        }
      }
    },
    "Full screen preview, uses more battery": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フルスクリーンプレビュー、バッテリー消費が増加"
