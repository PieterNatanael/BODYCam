    "Alarms need iOS 26 or later.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarme benötigen iOS 26 oder neuer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les alarmes nécessitent iOS 26 ou version ultérieure."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アラームにはiOS 26以降が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알람 기능은 iOS 26 이상이 필요합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "闹钟功能需要 iOS 26 或更高版本。"
          }
        }
      }
    },
    "Alarms need iOS 26 or later. Use Set as Reminder instead, it still opens this item when you tap it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarme benötigen iOS 26 oder neuer. Verwende stattdessen „Als Erinnerung festlegen“ — auch damit öffnet ein Tipp dieses Element."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les alarmes nécessitent iOS 26 ou version ultérieure. Utilisez plutôt « Définir comme rappel », cela ouvre aussi cet élément lorsque vous appuyez dessus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アラームにはiOS 26以降が必要です。代わりに「リマインダーとして設定」を使用してください。タップすればこの項目を開けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알람 기능은 iOS 26 이상이 필요합니다. 대신 \"리마인더로 설정\"을 사용하세요. 탭하면 이 항목이 열립니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "闹钟功能需要 iOS 26 或更高版本。请改用「设为提醒」，点击后同样可以打开此项目。"
          }
        }
      }
    },
    "ALSO FROM US": {
      "localizations": {
        "de": {
          "stringUnit": {
