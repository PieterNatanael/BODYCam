          "stringUnit": {
            "state": "translated",
            "value": "全屏预览，更耗电"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 화면 미리보기, 배터리 소모 증가"
          }
        }
      }
    },
    "Script on screen, preview shrinks to a movable corner": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面に台本を表示、プレビューは移動可能な小窓に縮小"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Skript auf dem Bildschirm, Vorschau schrumpft zu einem verschiebbaren Fenster"
          }
        },
        "fr": {
