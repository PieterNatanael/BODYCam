    "Everything you record stays on your device. We do not collect it, upload it, or share it with anyone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles, was du aufnimmst, bleibt auf deinem Gerät. Wir erfassen es nicht, laden es nicht hoch und teilen es mit niemandem."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce que vous enregistrez reste sur votre appareil. Nous ne le collectons pas, ne le téléversons pas et ne le partageons avec personne."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua yang Anda rekam tetap berada di perangkat Anda. Kami tidak mengumpulkan, mengunggah, atau membagikannya kepada siapa pun."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録画した内容はすべて端末内に保存されます。収集、アップロード、第三者との共有は一切行いません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹화한 모든 내용은 기기에만 저장됩니다. 수집하거나 업로드하거나 누구와도 공유하지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你录制的所有内容都保存在你的设备上。我们不会收集、上传或与任何人分享。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你錄製的所有內容都保存在你的裝置上。我們不會收集、上傳或與任何人分享。"
          }
        }
      }
    },
