    "Rings with the iOS alarm sound, breaking through silent mode and Focus.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klingelt mit dem iOS Alarmton und durchbricht dabei den Stumm-Modus und Fokus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonne avec la sonnerie d'alarme iOS, en passant outre le mode silencieux et Focus."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berdering dengan suara alarm iOS, menembus mode senyap dan Fokus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOSのアラーム音で鳴り、マナーモードやフォーカスを突破して通知します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 알람 소리로 울리며, 무음 모드와 집중 모드를 뚫고 알립니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 iOS 闹钟铃声响铃，可穿透静音模式和专注模式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 iOS 鬧鐘鈴聲響鈴，可穿透靜音模式和專注模式。"
          }
        }
      }
    },
