            "value": "알림을 탭하여 이 %@을 엽니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按通知以打开此%@。"
          }
        }
      }
    },
    "Tap View on the alarm to open this %@.": {
      "localizations": {
