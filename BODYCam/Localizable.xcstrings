    "Fires at this time every day until you cancel it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löst jeden Tag zu dieser Uhrzeit aus, bis du es abbrichst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se déclenche à cette heure chaque jour jusqu'à ce que vous l'annuliez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この時刻に毎日鳴ります。キャンセルするまで続きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "취소할 때까지 매일 이 시간에 울립니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每天在此时间触发，直到你取消为止。"
          }
        }
      }
    },
    "Fires once, at the next time this comes around.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löst einmal aus, zum nächsten Mal, wenn diese Uhrzeit erreicht wird."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se déclenche une seule fois, la prochaine fois que cette heure arrive."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次にこの時刻が来たときに一度だけ鳴ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음번 이 시간이 되었을 때 한 번만 울립니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在下一次到达该时间时触发一次。"
          }
        }
      }
    },
    "Flat and calm, soft green accents": {
