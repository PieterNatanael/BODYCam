    "To record sound along with your videos.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Aufnehmen von Ton zusammen mit deinen Videos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour enregistrer le son avec vos vidéos."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk merekam suara bersama video Anda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画と一緒に音声を録音するために使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동영상과 함께 소리를 녹음하는 데 사용됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于在录制视频时同时录音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於在錄製影片時同時錄音。"
          }
        }
      }
    },
    "To record video and take photos. The app cannot work without this.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Aufnehmen von Videos und Fotos. Ohne dies kann die App nicht funktionieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour enregistrer des vidéos et prendre des photos. L'application ne peut pas fonctionner sans cela."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk merekam video dan mengambil foto. Aplikasi tidak dapat berfungsi tanpa ini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画の録画と写真の撮影に使用します。これがないとアプリは動作しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동영상 녹화와 사진 촬영에 사용됩니다. 이 권한 없이는 앱이 작동하지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于录制视频和拍摄照片。没有此权限应用无法运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於錄製影片和拍攝照片。沒有此權限應用程式無法運作。"
          }
        }
      }
    },
