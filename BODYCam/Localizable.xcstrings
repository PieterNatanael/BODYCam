    "Alarms need iOS 26 or later.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarme benötigen iOS 26 oder neuer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les alarmes nécessitent iOS 26 ou version ultérieure."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarm memerlukan iOS 26 atau lebih baru."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アラームにはiOS 26以降が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알람 기능은 iOS 26 이상이 필요합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "闹钟功能需要 iOS 26 或更高版本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鬧鐘功能需要 iOS 26 或更高版本。"
          }
        }
      }
    },
    "Alarms need iOS 26 or later. Use Set as Reminder instead, it still opens this item when you tap it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarme benötigen iOS 26 oder neuer. Verwende stattdessen „Als Erinnerung festlegen“ — auch damit öffnet ein Tipp dieses Element."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les alarmes nécessitent iOS 26 ou version ultérieure. Utilisez plutôt « Définir comme rappel », cela ouvre aussi cet élément lorsque vous appuyez dessus."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarm memerlukan iOS 26 atau lebih baru. Gunakan Jadikan Pengingat sebagai gantinya, item ini tetap akan terbuka saat diketuk."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アラームにはiOS 26以降が必要です。代わりに「リマインダーとして設定」を使用してください。タップすればこの項目を開けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알람 기능은 iOS 26 이상이 필요합니다. 대신 \"리마인더로 설정\"을 사용하세요. 탭하면 이 항목이 열립니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "闹钟功能需要 iOS 26 或更高版本。请改用「设为提醒」，点击后同样可以打开此项目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鬧鐘功能需要 iOS 26 或更高版本。請改用「設為提醒」，點擊後同樣可以開啟此項目。"
          }
        }
      }
    },
    "Always back up important footage to a safe location immediately after recording.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichere wichtiges Filmmaterial direkt nach der Aufnahme an einem sicheren Ort."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sauvegardez toujours les enregistrements importants dans un endroit sûr immédiatement après l'enregistrement."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selalu cadangkan rekaman penting ke lokasi yang aman segera setelah merekam."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "重要な映像は、録画後すぐに安全な場所へバックアップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중요한 영상은 녹화 직후 반드시 안전한 위치에 백업하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请务必在录制后立即将重要素材备份到安全的位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請務必在錄製後立即將重要素材備份到安全的位置。"
          }
        }
      }
    },
    "App Functionality": {},
    "App for you": {},
    "App updates may cause unexpected behaviour that could affect recording reliability.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "App-Updates können unerwartetes Verhalten verursachen, das die Zuverlässigkeit der Aufnahme beeinträchtigt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mises à jour de l'application peuvent provoquer un comportement inattendu affectant la fiabilité de l'enregistrement."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembaruan aplikasi dapat menyebabkan perilaku tak terduga yang memengaruhi keandalan perekaman."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリのアップデートにより、録画の信頼性に影響する予期せぬ動作が生じる場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 업데이트로 인해 녹화 안정성에 영향을 주는 예기치 않은 동작이 발생할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用更新可能导致意外行为，影响录制的可靠性。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "應用程式更新可能導致意外行為，影響錄製的可靠性。"
          }
        }
      }
    },
