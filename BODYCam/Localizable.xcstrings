    "Unable to determine available storage. Free up space and try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der verfügbare Speicherplatz konnte nicht ermittelt werden. Gib Speicherplatz frei und versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
